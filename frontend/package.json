{
  "name": "desviaciones-frontend",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5007",
    "build": "vite build",
    "deploy:tablet": "vite build && npx cap sync android && adb reverse tcp:3002 tcp:3002 && cd android && gradlew.bat installDebug && adb shell am start -n com.fisholg.desviaciones/com.fisholg.desviaciones.MainActivity",
    "build:release": "vite build && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "release:apk": "node scripts/release-apk.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "vite": "^8.0.10"
  }
}
